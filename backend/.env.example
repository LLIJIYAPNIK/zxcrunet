# Копия для локальной разработки: cp .env.example .env
ZXC_ENV=dev
ZXC_SERVICE_DOMAIN=zxc.ru.net
ZXC_DATABASE_URL=postgresql+asyncpg://zxc:zxc@localhost:5432/zxc
ZXC_REDIS_URL=redis://localhost:6379/0

# Адрес веб-приложения (ссылки в письмах) и источники, которым разрешены изменяющие запросы
ZXC_PUBLIC_URL=http://localhost:3000
ZXC_ALLOWED_ORIGINS=["http://localhost:3000"]

# Почта: локально — Mailpit из infra/docker-compose.dev.yml (веб: http://localhost:8025)
ZXC_SMTP_HOST=localhost
ZXC_SMTP_PORT=1025
ZXC_MAIL_FROM=zxcrunet <no-reply@zxc.ru.net>

# Production: zxc.ru.net and *.zxc.ru.net with a wildcard certificate (DNS-01 via Cloudflare),
# custom domains with on-demand TLS. Needs the custom build from infra/caddy/Dockerfile.
#
# Environment: ACME_EMAIL, CLOUDFLARE_API_TOKEN (Zone.DNS:Edit for zxc.ru.net),
# API_UPSTREAM (api:8000), WEB_UPSTREAM (web:3000).

{
	email {$ACME_EMAIL}
	on_demand_tls {
		# 200 only for verified and active custom domains. The API answers this path
		# only to direct requests from the Docker network.
		ask http://{$API_UPSTREAM:api:8000}/internal/tls/ask
	}
}

(zxcrunet) {
	encode zstd gzip

	# Never reachable from outside, whatever the host.
	handle /internal/* {
		respond 404
	}
	handle /api/* {
		reverse_proxy {$API_UPSTREAM:api:8000}
	}
	# Uploaded files straight from the volume.
	handle_path /media/* {
		root * /data/uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle {
		reverse_proxy {$WEB_UPSTREAM:web:3000}
	}
}

zxc.ru.net, *.zxc.ru.net {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
	}
	import zxcrunet
}

# Every other host is a custom domain: a certificate only after the API says yes.
https:// {
	tls {
		on_demand
	}
	import zxcrunet
}

http:// {
	redir https://{host}{uri} 308
}
